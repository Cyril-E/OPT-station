[Unit]
Description=OPT Station HTTPS gateway
After=network.target

[Service]
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/opt-station-caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/opt-station-caddy/config
StateDirectory=opt-station-caddy
StateDirectoryMode=0700
ExecStart=/usr/bin/caddy run --config /etc/opt-station/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
